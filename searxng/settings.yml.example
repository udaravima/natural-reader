# SearXNG config for the web_search tool.
#
#   cp searxng/settings.yml.example searxng/settings.yml
#   # then set a real secret_key:  openssl rand -hex 32
#
# JSON output is OFF by default in SearXNG — without it, /search?format=json
# returns HTTP 403.
use_default_settings: true
server:
  # Generate with: openssl rand -hex 32
  secret_key: "CHANGE_ME_openssl_rand_hex_32"
  limiter: false
search:
  # API-only: JSON is all the backend needs. There is no separate "no-UI"
  # SearXNG image, but dropping "html" means the browser UI can't render search
  # results — effectively API-only. Add "- html" back if you want to browse it.
  formats:
    - json
