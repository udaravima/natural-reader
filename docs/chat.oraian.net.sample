server {
    listen 80;
    server_name chat.oraian.net;
    # Force redirect to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name chat.oraian.net;

    # SSL Configuration
    ssl_certificate /etc/nginx/ssl/oraian/chat.oraian.net.crt;
    ssl_certificate_key /etc/nginx/ssl/oraian/chat.oraian.net.key;

    # Fallback (RSA)
    ssl_certificate /etc/nginx/ssl/oraian/rsa-fallback.crt;
    ssl_certificate_key /etc/nginx/ssl/oraian/rsa-fallback.key;

    # Optimization for modern curves (Ed25519)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;

    root /var/www/chat.oraian.net/dist;
    index index.html;

    # Serve ES modules with a JS MIME type so Firefox accepts them
    location ~ \.mjs$ {
       types { } default_type text/javascript;

       # Vite hashes filenames already, so cache them aggressively
       add_header Cache-Control "public, max-age=31536000, immutable";
       try_files $uri =404;
    }

    location ~ \.wasm$ {
       types { } default_type application/wasm;
       add_header Cache-Control "public, max-age=31536000, immutable";
    }    

    location / {
       try_files $uri $uri/ /index.html;
    }

    location /v1/ {
        # Assuming TTS running on port 8000
        proxy_pass http://127.0.0.1:8000/v1/;

        # Standard Proxy Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket Support (Crucial for chat)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts for long-lived chat connections
        proxy_read_timeout 86400;
    }

    location /api/ {
        # Assuming your local chat app runs on port 3000
        proxy_pass http://127.0.0.1:11434/api/;

        # Standard Proxy Headers
        proxy_set_header Host localhost:11434;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;

        # WebSocket Support (Crucial for chat)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts for long-lived chat connections
        proxy_read_timeout 86400;
	proxy_buffering off;
    }
}

# ---------------------------------------------------------------------------
# OPTIONAL HARDENING — uncomment what fits your deployment.
# See README.md → "🔒 Security & Hardening" for the rationale and quick picks.
# ---------------------------------------------------------------------------
#
# 1) HTTP Basic Auth — recommended for any single-user / small-team deploy.
# -------------------------------------------------------------------------
# Create the password file once:
#     sudo htpasswd -B -c /etc/nginx/htpasswd you
# Add more users with:
#     sudo htpasswd -B    /etc/nginx/htpasswd teammate
# Then paste these two lines INSIDE both `location /v1/ {}` and `location /api/ {}`:
#
#     auth_basic           "Neural Reader";
#     auth_basic_user_file /etc/nginx/htpasswd;
#
#
# 2) IP allowlist — for static-IP or VPN setups.
# -----------------------------------------------
# Inside each backend location block (BEFORE `proxy_pass`):
#
#     allow 203.0.113.42;     # your home IP
#     allow 10.0.0.0/8;       # internal LAN / VPN
#     deny  all;
#
#
# 3) Rate limiting — caps a single client's request rate. Stack under auth.
# --------------------------------------------------------------------------
# In the top-level `http {}` block of /etc/nginx/nginx.conf, declare the zones:
#
#     limit_req_zone $binary_remote_addr zone=tts:10m  rate=5r/s;
#     limit_req_zone $binary_remote_addr zone=chat:10m rate=2r/s;
#
# Then inside this server block, apply per-location:
#
#     location /v1/      { limit_req zone=tts  burst=10 nodelay; ... }
#     location /api/chat { limit_req zone=chat burst=3  nodelay; ... }
#
# (The chat zone needs its own sub-location since /api/tags etc. shouldn't be
#  rate-limited as aggressively.)
#
#
# 4) Tighten Kokoro CORS — server-side, NOT nginx.
# -------------------------------------------------
# Edit server/app.py. Replace:
#
#     allow_origins=["*"]
#
# with the actual frontend origin(s):
#
#     allow_origins=["https://chat.oraian.net"]
#
# Then reload uvicorn (e.g. `pkill -HUP -f uvicorn` or restart the service).
# ---------------------------------------------------------------------------
