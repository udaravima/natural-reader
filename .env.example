# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Defaults match docker-compose.yml.
# DATABASE_URL=postgresql://natural_reader:natural_reader@localhost:5433/natural_reader

# ─── Ollama ──────────────────────────────────────────────────────────────────
# Base URL of the Ollama server.
# OLLAMA_URL=http://localhost:11434

# ─── Embedding Model ────────────────────────────────────────────────────────
# Model name as known to Ollama (must be pulled first: `ollama pull <model>`).
# EMBEDDING_MODEL=nomic-embed-text

# Dimensionality of the embedding vector. Must match the model's output dim.
# Changing this requires re-creating the doc_chunks.embedding column and
# re-indexing all documents.
#   nomic-embed-text  → 768
#   mxbai-embed-large → 1024
#   all-minilm         → 384
# EMBEDDING_DIM=768

# Maximum characters sent to the embedding model per chunk. Text exceeding
# this limit is truncated. Tune this to match the model's context window:
#   nomic-embed-text  (2048 tokens default in Ollama) → ~2000 chars
#   mxbai-embed-large (512 tokens)                    → ~1500 chars
# If you've increased num_ctx in a custom Modelfile, raise this accordingly.
# EMBEDDING_MAX_CHARS=2000

# Per-request timeout in seconds for Ollama embedding calls.
# EMBEDDING_TIMEOUT_S=30

# Maximum number of concurrent embedding requests to Ollama.
# Higher values saturate the pipeline faster but use more memory.
# EMBEDDING_MAX_CONCURRENCY=4
