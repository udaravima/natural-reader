# ─── Server / Network ────────────────────────────────────────────────────────
# Bind address for the FastAPI/Kokoro server. Defaults to 127.0.0.1 (localhost
# only) so the API is never exposed off-box by accident. For a containerized or
# reverse-proxied deployment, set HOST=0.0.0.0 explicitly — the proxy should be
# the only internet-facing surface.
# HOST=127.0.0.1
# PORT=8000
# WORKERS=1

# Comma-separated CORS allowlist: other web origins allowed to call the API from
# a browser. Unset = none, which is right when the SPA is served from the same
# origin as the API (the default) — the read-aloud extension calls from its
# service worker and needs no entry. Set it only when the SPA lives on another
# origin; doing so also enables credentialed (cookie) requests. "*" allows
# every website, without credentials.
# FRONTEND_ORIGIN=https://reader.example.com

# ─── Authentication (OIDC / multi-user) ──────────────────────────────────────
# The app is an OIDC Relying Party. Point these at your IdP (e.g. Keycloak).
# With AUTH_ENABLED=true (default) and OIDC unset, /v1/auth/login returns 503 but
# TTS still serves; set the four OIDC_* vars to enable login.
# OIDC_ISSUER=https://keycloak.example.com/realms/natural-reader
# OIDC_CLIENT_ID=natural-reader
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URL=https://reader.example.com/v1/auth/callback
# Where Settings → Profile's "Manage your account" goes (name, password, two-step
# sign-in). Unset: a Keycloak issuer (…/realms/<realm>) gives its account console,
# <issuer>/account; any other IdP gives no link. "off" hides the link.
# OIDC_ACCOUNT_URL=https://id.example.com/account
#
# Local dev against the docker-compose Keycloak + checked-in realm
# (deploy/keycloak/realm-export.json). The issuer URL must be identical for the
# browser AND the backend (both localhost:18080) or token validation fails.
# OIDC_ISSUER=http://localhost:18080/realms/natural-reader
# OIDC_CLIENT_ID=natural-reader
# OIDC_CLIENT_SECRET=natural-reader-dev-secret
# OIDC_REDIRECT_URL=http://localhost:5173/v1/auth/callback   # Vite dev; use your nginx origin for prod-like
#
# Production behind nginx + TLS (see docs/DEPLOYMENT.md). All five of ISSUER,
# REDIRECT_URL, COOKIE_SECURE, the two KC_* vars below, AND the live realm's
# redirect URIs must agree on https + hostname, or login fails a different way at
# each mismatch:
# OIDC_ISSUER=https://auth.example.com/realms/natural-reader
# OIDC_CLIENT_ID=natural-reader
# OIDC_CLIENT_SECRET=<realm client secret>
# OIDC_REDIRECT_URL=https://chat.example.com/v1/auth/callback
#
# Keycloak behind a TLS-terminating reverse proxy (consumed by docker-compose.yml,
# empty by default so plain localhost dev is unchanged). Without these, Keycloak
# emits http:// asset/iframe URLs the browser blocks as mixed content and its OIDC
# `issuer` won't match OIDC_ISSUER. Set both for a proxied deploy:
# KC_PROXY_HEADERS=xforwarded
# KC_HOSTNAME=https://auth.example.com
#
# How ./startup.sh up / up-with-dev-auth run the backend: container (default,
# the image with your working tree mounted) or venv (bare metal: run.py from
# .venv, as before the container; needs ./startup.sh init). A shell value wins.
# BACKEND_RUNTIME=container
#
# Whether ./startup.sh start launches the compose Keycloak: auto (default) = yes
# when OIDC_ISSUER is http://localhost:18080/… or KC_HOSTNAME is set; false for an
# external IdP.
# LOCAL_KEYCLOAK=auto
#
# Signs the transient OIDC-flow cookie. MANDATORY for any non-loopback (exposed
# or containerized) bind: the server REFUSES TO START without a value of >= 32
# chars, so it can never fall back to a forgeable signing key. On a loopback bind
# it's optional — an ephemeral per-process secret is used (won't survive a
# restart or work across WORKERS>1). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# App session lifetime and cookie flags. A sign-in lasts at most
# SESSION_TTL_HOURS (absolute, from sign-in), and ends sooner when the browser
# hasn't used it for SESSION_IDLE_HOURS (0 = no idle limit). Both in hours.
# Signing in again goes through your identity server, which may remember you
# (Keycloak: its own SSO session settings) and skip the password.
# SESSION_TTL_HOURS=168
# SESSION_IDLE_HOURS=12
# COOKIE_SECURE=true            # set false only for local http (no TLS) testing
# Leave COOKIE_DOMAIN unset for localhost. Only set it (to your registrable
# domain) once served from a real hostname — a value that doesn't match the
# origin silently drops the session cookie and login appears to do nothing.
# COOKIE_DOMAIN=
#
# Pre-designate the admin: the seed admin row's email is set to this, so this
# person's first OIDC login claims it and inherits any pre-existing data. Removes
# the "first login wins" race on a fresh multi-user install.
#   TRAP: setting this routes the founder through the *email-claim* path
#   (resolve_or_provision_user branch 2), which — unlike the first-login race
#   (branch 3) — does NOT force-grant {admin,reader,chat}. It just mirrors
#   whatever realm roles the token carries. So if this founder's Keycloak user
#   has no realm roles assigned, their capabilities are wiped to empty on the
#   FIRST login and they land on "your account is active but has no access yet".
#   Guard against it EITHER by assigning the realm roles to that user in Keycloak
#   (the checked-in realm-export gives admin-user reader/chat/admin directly) OR
#   by setting KC_ADMIN_* below so the app self-heals the roles on bootstrap.
#   See docs/DEPLOYMENT.md Trap 4 and docs/IDENTITY_AND_ROLES.md.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
#
# Local-dev escape hatch: skip OIDC entirely and treat every request as the
# bootstrap admin. REFUSES TO START unless HOST is loopback. Never set on an
# exposed server.
# AUTH_ENABLED=true
#
# Keycloak Admin REST service account (enables full user provisioning + role
# management from the app). The client_secret MUST match the natural-reader-admin
# client's secret in the LIVE realm (dev value in realm-export.json is
# natural-reader-admin-dev-secret; rotate it for a real deployment).
#   Unset = app-only degraded mode, with two consequences worth knowing:
#     1. The founder-bootstrap self-heal is dead: when the seed admin is first
#        claimed, the app tries to assign reader/chat/admin back into Keycloak so
#        the next login's sync doesn't demote the founder — that call is skipped
#        when this is unset (see BOOTSTRAP_ADMIN_EMAIL trap above).
#     2. The admin console's capability editor becomes a DB-only sticky note: an
#        edit on an already-linked user can't reach Keycloak, so login sync
#        reverts it on that user's next login.
# KC_ADMIN_CLIENT_ID=natural-reader-admin
# KC_ADMIN_CLIENT_SECRET=change-me

# ─── TTS request limits (SEC-4) ──────────────────────────────────────────────
# Caps that keep a single request from monopolizing Kokoro (inference is
# serialized under one global lock).
# TTS_MAX_TEXT_CHARS=20000
# TTS_MAX_SENTENCES=2000
# TTS_MAX_SENTENCE_CHARS=5000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Defaults match docker-compose.yml.
# DATABASE_URL=postgresql://natural_reader:natural_reader@127.0.0.1:5433/natural_reader
# Password for the docker-compose Postgres (compose reads POSTGRES_PASSWORD).
# Override for anything past a local dev box, and mirror it in DATABASE_URL.
# POSTGRES_PASSWORD=natural_reader

# ─── Ollama ──────────────────────────────────────────────────────────────────
# Base URL of the Ollama server.
# OLLAMA_URL=http://localhost:11434

# ─── Inference gateway (model router) ────────────────────────────────────────
# The SPA's chat runs through the authenticated /v1/inference/* gateway (the
# "Inference source: Server" setting). These knobs shape what that gateway
# allows and spends.
#
# Comma-separated model allowlist served through /v1/inference/*. Unset = all
# installed models (local-dev convenience). Set it on any shared deployment —
# it's also what the SPA's model dropdown offers.
# INFERENCE_MODELS=gemma3,qwen2.5
#
# Default per-user daily token budget (prompt + eval, from Ollama's real
# counts). Unset or 0 = unlimited. Per-user override lives on the users table
# (admin PATCH /v1/admin/users/{id}) — NULL = this default, 0 = unlimited.
# Budgets roll at UTC midnight.
# INFERENCE_DAILY_TOKEN_BUDGET=500000
#
# Limits on two settings each user's Settings page sends with every message to
# an Ollama model. On a shared Ollama they are everyone's memory: a context size
# allocates its cache up front, and "keep warm: Always" holds the model in RAM
# until Ollama restarts. Requests above a limit are clamped, not refused.
# Context size in tokens (0 = no limit):
# INFERENCE_NUM_CTX_MAX=32768
# Longest keep-alive, an Ollama duration (30m, 1h) or seconds; -1 = no limit.
# A user's "0" (unload after every reply) is never sent: everyone would reload.
# INFERENCE_KEEP_ALIVE_MAX=30m
# Ollama's own scheduler decides how many models stay loaded (set these on the
# Ollama server, not here): OLLAMA_MAX_LOADED_MODELS=2 on a small machine keeps
# one chat model plus the embedding model; 1 would make them evict each other
# on every message. OLLAMA_KEEP_ALIVE sets its default hold time.
#
# Upstream read timeout (seconds) for streamed generations — slow models can
# think for minutes, so this is generous by default.
# INFERENCE_TIMEOUT_S=300
#
# Model for server-side summarize tasks (the document-library description
# generation to come) and the next fallback for the reader's model, see READER_MODEL
# below. Web search no longer summarizes pages. Replaces the older
# WEB_SEARCH_SUMMARY_MODEL name, which still works as a fallback. Goes through
# the model router below, so a bare name like "llama3.2:3b" (no "provider:"
# prefix) resolves to the first provider of kind ollama.
# SUMMARIZE_MODEL=llama3.2:3b

# ---- Model providers (C1) ------------------------------------------------
# Unset = one provider named "ollama" at OLLAMA_URL, limited by
# INFERENCE_MODELS (exactly the pre-C1 behaviour). Model ids in the chat are
# "<provider>:<model>", e.g. ollama:qwen2.5:7b.
#
# To add providers, list their names in display order and describe each one.
# KIND is ollama (native API) or openai (any OpenAI-compatible server: vLLM,
# OpenRouter, LiteLLM, Ollama's own /v1). For kind=openai, URL is the API base
# INCLUDING the version path. API keys stay on the server: they are never sent
# to the browser, logged, or shown in the admin console.
# INFERENCE_PROVIDERS=local,openrouter
# INFERENCE_LOCAL_KIND=ollama
# INFERENCE_LOCAL_URL=http://localhost:11434
# INFERENCE_OPENROUTER_KIND=openai
# INFERENCE_OPENROUTER_URL=https://openrouter.example.com/api/v1
# INFERENCE_OPENROUTER_API_KEY=sk-your-key
#   ^ the key is INFERENCE_<NAME>_API_KEY, <NAME> = the provider's name above in
#     capitals. A bare OPENROUTER_API_KEY is ignored (requests then fail with
#     "The provider rejected this server's credentials").
# INFERENCE_OPENROUTER_MODELS=vendor/model-a,vendor/model-b   # allow-list; unset = all it lists
#
# Trap: OLLAMA_URL is still where document EMBEDDINGS run, even when
# INFERENCE_PROVIDERS is set. Remove it and indexing calls localhost:11434.
#
# INFERENCE_TIMEOUT_S above is an IDLE timeout (seconds of silence from a
# provider, first token included), not a cap on how long a reply may take.

# ---- Chat orchestrator (C1) ----------------------------------------------
# Tool rounds per turn before one final answer with tools off. Several rounds
# let the model follow a trail (search, then search for what it found). The
# last round's results tell the model to answer now.
# CHAT_MAX_TOOL_ROUNDS=3
# The same, in a chat about a whole project (0-20). A project question often
# needs a round to read sections of several documents and another to check.
# 0 turns the tools off in project chats.
# CHAT_PROJECT_MAX_TOOL_ROUNDS=5
# Characters of tool results one answer may add to the prompt. Past this, a
# call returns "Search budget for this answer used up" instead of its result.
# CHAT_TOOL_RESULT_BUDGET_CHARS=24000
# Stage 0: search the open document BEFORE the model runs: auto|on|off.
# auto (default): only for a model with no document tools, whose only way to
#   see the document it is; a model with tools searches for itself.
# on: always; a model with tools gets the passages as the result of a
#   search_documents call the app made for it.
# off: never.
# Measured (docs/CHAT_WITH_PDF.md §6.4): gemma4:e4b on a CPU scored 5/9 with
# it on and 9/9 off, and wasn't slower off: handed passages, it answered from
# them instead of searching. A 31B model did as well either way.
# CHAT_PREFETCH=auto
# Passages scoring at least this (cosine similarity) are used.
# Measured with nomic-embed-text (docs/CHAT_WITH_PDF.md §6.5): on a short guide
# questions it answers scored 0.72-0.83 and small talk 0.47-0.60; on a long
# book 0.66-0.78 against 0.51-0.65, so there "thanks!" can still prefetch. A
# different embedding model scores differently. 1 also disables prefetch.
# CHAT_PREFETCH_MIN_SCORE=0.6
# CHAT_PREFETCH_K=4
# The search_documents tool leaves out passages scoring below this: a noise
# floor only. With nomic-embed-text every message measured, small talk
# included, had a passage above 0.47, so no value separates passages that
# answer from ones that don't; the model reads them to decide. A different
# embedding model may need its own value.
# CHAT_SEARCH_MIN_SCORE=0.45
# The read_document_pages tool returns up to 3 whole pages per call, cut at this
# many characters (a PDF page is about 3,000-4,000).
# CHAT_READ_PAGES_MAX_CHARS=12000
# Tokens kept free for the reply when old history is trimmed to fit.
# CHAT_REPLY_RESERVE_TOKENS=2048
# Tokens counted per image/audio attachment when trimming (a deliberate overestimate).
# CHAT_ATTACHMENT_TOKEN_ESTIMATE=1500
# Largest chat request (message + attachments), in MB. Attachment bytes are
# stored with the chat so follow-up questions can see them; deleting the chat deletes them.
# Also caps the body of POST /v1/chat/sessions/import (the legacy-chat import
# the SPA uses to bring an old browser-only chat onto the server): that request
# carries message text and attachment metadata, never attachment bytes.
# CHAT_MAX_REQUEST_MB=25
# A text or Markdown file with the assistant's profile: its name, personality,
# tone and house rules. It is put first in every chat's system message; the
# app's own rules about documents and tools follow it and take precedence.
# Read on every message, so an edit applies without a restart. An admin can
# override it in the admin console (Assistant). Unset = none. At most 8,000
# characters are used.
# CHAT_ASSISTANT_PROFILE_FILE=/etc/natural-reader/assistant.md

# ---- Project chat (C2.1) ---------------------------------------------------
# A chat can be about a whole project. The assistant first gets a map of the
# project (each document's name, pages and outline), then searches and reads
# with tools. A value outside its range logs a warning and the default is used.
#
# Characters (500-100000) the project map may take in the system message.
# 6000 is about 1,500 tokens and leaves room for an answer in an 8,192-token
# window. Over it, the outlines are shortened step by step (deepest headings
# first, then fewer headings per document, then names and pages only), and the
# assistant gets a document_outline tool to read a full outline. Raise it only
# if your chat models run with a large context window: the map is sent with
# every message.
# CHAT_PROJECT_MAP_CHARS=6000
# A project search ranks every searchable passage of the project once, taking
# this many candidates (1-500) from the meaning ranking and from the exact-word
# ranking before fusing them. A single-document search always uses 20.
# CHAT_PROJECT_FUSION_DEPTH=50
# Passages (1-10) one document may give a project search before others get a
# turn. If the search finds fewer than it was asked for, the skipped passages
# fill the rest in rank order, so a document that holds all the answers still
# fills the list. 2 keeps one long document from taking all five default slots.
# CHAT_SEARCH_PER_DOC=2
# Pages (1-200) one extract_from_documents call hands to the reader. Over it,
# the pages closest to the question are read and the rest are listed as not read.
# 12 pages is about three or four reader batches. On a CPU the reader is the slow
# part of a project chat (see READER_* below): measure before raising it.
# CHAT_EXTRACT_MAX_PAGES=12
# Characters (500-50000) one extract_from_documents result may take, counted as
# compact JSON; over it, the last facts are dropped and "more" says how many. The
# model sees the result indented, so what reaches it is typically 15-25% larger
# (more when the facts are short).
# CHAT_EXTRACT_OUTPUT_CHARS=4000

# ---- The reader (C2.1) -----------------------------------------------------
# The reader is a separate, small model call that reads document pages or web
# pages for the chat model's goal and hands back only the facts, each with a
# quote the app has checked against the source. The chat model's context then
# holds findings, not pages. Used by extract_from_documents and read_web_pages.
# A value outside its range logs a warning and the next name in the chain, or
# the default, is used.
#
# The model the reader runs on, like SUMMARIZE_MODEL ("provider:name", or a bare
# name for the first ollama provider). Chain: READER_MODEL, then SUMMARIZE_MODEL,
# then WEB_SEARCH_SUMMARY_MODEL, then llama3.2:3b.
# The value "chat" reads with the model of the turn itself. On a CPU-only Ollama
# set READER_MODEL=chat (SUMMARIZE_MODEL=chat means the same for the reader):
# otherwise a second model is loaded into RAM next to the chat model, and
# swapping models costs seconds to minutes on a project question. Keep a
# separate small model when the chat model is a large or paid one: every batch
# is a full model call, and a small model is cheaper and faster for it.
# READER_MODEL=llama3.2:3b
# Source characters (500-200000) per reader batch; 12000 is about 3,000 tokens.
# A page longer than this is read in overlapping pieces.
# READER_INPUT_CHARS=12000
# Most characters (100-20000) the reader may return per batch. It is told to
# stay under this, and its reply is capped at about this length; a reply cut
# off in the middle counts as a failed batch.
# READER_OUTPUT_CHARS=1200
# Reader batches running at once (1-32). A CPU Ollama serves them one by one
# anyway, so 2 mostly helps providers that run requests in parallel.
# READER_MAX_CONCURRENCY=2
# Seconds (1-3600) one batch may take before it counts as failed: the pages in
# it are reported as not read, and a web page falls back to a short excerpt.
# WEB_SEARCH_SUMMARY_TIMEOUT_S is still read when this is unset.
# READER_TIMEOUT_S=60

# ─── Embedding Model ────────────────────────────────────────────────────────
# Model name as known to Ollama (must be pulled first: `ollama pull <model>`).
# EMBEDDING_MODEL=nomic-embed-text

# Dimensionality of the embedding vector. Must match the model's output dim.
# Changing this requires re-creating the doc_chunks.embedding column and
# re-indexing all documents.
#   nomic-embed-text  → 768
#   mxbai-embed-large → 1024
#   all-minilm         → 384
# EMBEDDING_DIM=768

# Maximum characters sent to the embedding model per chunk. Text exceeding
# this limit is truncated. Tune this to match the model's context window:
#   nomic-embed-text  (2048 tokens default in Ollama) → ~2000 chars
#   mxbai-embed-large (512 tokens)                    → ~1500 chars
# If you've increased num_ctx in a custom Modelfile, raise this accordingly.
# EMBEDDING_MAX_CHARS=2000

# Text put before what is embedded. Retrieval models are trained with such
# prefixes. Unset: nomic-embed-text* gets "search_document: " and
# "search_query: ", and any other model none. Set to empty to turn them off.
# Check your model's card: e5 uses "passage: " and "query: ". Keep a prefix under
# 64 characters: that is the room chunk sizes leave for it.
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_QUERY_PREFIX=

# Chunks longer than this many characters are split, overlapping by
# CHUNK_OVERLAP_CHARS, so the whole of every page is searchable. Keep
# CHUNK_MAX_CHARS plus the prefix under EMBEDDING_MAX_CHARS. The overlap is at
# most a quarter of CHUNK_MAX_CHARS.
# CHUNK_MAX_CHARS=1200
# CHUNK_OVERLAP_CHARS=200
# (Read at startup: restart the backend after changing them. CHUNK_MAX_CHARS
# is clamped to EMBEDDING_MAX_CHARS minus 64, so a part always fits.)

# Changing the embedding model, a prefix or the chunk sizes changes the
# "embedding profile". An indexed document made under another profile is
# rebuilt in the background the first time someone chats with it or searches
# it. Its old chunks keep answering until the new ones swap in. If the MODEL
# changed, the document isn't searched until then, because vectors from two
# models can't be compared.

# Per-request timeout in seconds for Ollama embedding calls.
# EMBEDDING_TIMEOUT_S=30

# Maximum number of concurrent embedding requests to Ollama.
# Higher values saturate the pipeline faster but use more memory.
# EMBEDDING_MAX_CONCURRENCY=4

# ─── Web Search (SearXNG-backed web_search tool) ─────────────────────────────
# How the chat uses the web:
#   ask  (default) every web search waits for the user's yes: the assistant can
#                  only offer a search, and the user approves it on the offer.
#   auto           the assistant searches the web on its own, then reads the
#                  pages it picks (read_web_pages).
#   off            no web search in chat.
# This is the starting value: an admin's choice in the admin console (Chat
# options) wins over it, and applies from the next message. "Use the server
# setting" in that section hands control back to this value. A value that is
# none of ask|auto|off is ignored with a warning (ask applies). All modes still
# need SEARXNG_URL.
# CHAT_WEB_SEARCH=ask
#
# Base URL of the self-hosted SearXNG instance (see docker-compose.yml). JSON
# output must be enabled in searxng/settings.yml or every search 403s.
# (docker-compose binds it to 127.0.0.1:18043 by default — localhost only.)
# SEARXNG_URL=http://localhost:18043
#
# Web search lists results only (title, site, address, snippet): it fetches no
# page and calls no model. The pages the assistant picks to read are fetched when
# it asks (read_web_pages) and read by the reader (READER_* above). The older
# WEB_SEARCH_SUMMARY_MODEL name still works as a fallback for READER_MODEL. The
# old cut of each page at its first 6,000 characters is gone: the reader gets the
# passages from anywhere on the page that best match the goal.
# WEB_SEARCH_SUMMARY_MODEL=llama3.2:3b
#
# Results listed per search (1-10).
# WEB_SEARCH_RESULT_COUNT=5
#
# Pages fetched at once when the assistant reads several results.
# WEB_SEARCH_MAX_CONCURRENCY=4
#
# Per-request timeout (seconds) for the SearXNG query and for each redirect hop
# of a page fetch.
# WEB_SEARCH_FETCH_TIMEOUT_S=8
#
# Total deadline (seconds) for one page fetch — redirects plus the final
# streamed body — so a body that trickles in slowly enough to dodge the
# per-hop timeout above still can't hold a fetch open indefinitely.
# WEB_SEARCH_FETCH_TOTAL_S=15
#
# Fallback for READER_TIMEOUT_S (seconds), used only when that is unset.
# WEB_SEARCH_SUMMARY_TIMEOUT_S=30

# ─── Document storage & uploads (A1) ──────────────────────────────────────────
# Where uploaded document bytes live (<dir>/<doc_id>.<ext>). Falls back to
# PDF_STORAGE_DIR (the pre-A1 name), then ./data/pdfs. Existing files stay put.
# DOC_STORAGE_DIR=./data/pdfs
# PDF_STORAGE_DIR=./data/pdfs
# Container note: DOC_STORAGE_DIR / LOG_DIR / CHAT_ASSISTANT_PROFILE_FILE are HOST
# paths; ./startup.sh mounts them into the backend container. LOG_AUDIT_FILE is
# ignored in the container (audit.log is written under LOG_DIR).
#
# Docling conversion (PDF/DOCX/PPTX/HTML/images → Markdown). Off by default.
# DOCLING_ENABLED=true also builds the container image with Docling
# (./startup.sh rebuild); a venv needs pip install -r requirements-docling.txt.
# DOCLING_ENABLED=false
# Upload size caps in MB. Over the cap → HTTP 413.
# PDF_UPLOAD_MAX_MB=50
# TEXT_UPLOAD_MAX_MB=10

# ─── Projects & people directory (A0) ─────────────────────────────────────────
# Who can be found when adding someone to a project or sharing a document.
#   exact  — only by a full email address (default)
#   domain — type-ahead among people with the caller's email domain, only when
#            that domain is listed in USER_DIRECTORY_DOMAINS (others: exact)
#   open   — type-ahead over everyone (GitLab's default)
# An exact email works in every mode. Disabled accounts never appear. A site
# admin always gets type-ahead over everyone, emails shown, whatever the mode
# (the admin console lists everyone anyway).
# USER_DIRECTORY_MODE=exact
# Comma-separated organisation email domains for `domain` mode.
# USER_DIRECTORY_DOMAINS=example.com,corp.example.com
# Show email addresses in lookups and member lists (true|false).
# USER_DIRECTORY_SHOW_EMAIL=false
# Who may create projects: readers (anyone with the reader capability) | admins.
# PROJECT_CREATION=readers
# Projects one person may create (count). 0 = unlimited. Admins can override per
# user in the admin console; admins themselves are never limited.
# PROJECT_LIMIT_PER_USER=20
# Keep project activity history this many days (0 = forever). Read at startup;
# older events are deleted then and every 24 hours.
# PROJECT_EVENTS_RETENTION_DAYS=0

# ─── Logging ─────────────────────────────────────────────────────────────────
# The backend logs to the console AND a file that starts afresh on a schedule
# (logs/ is gitignored); the old ones are kept as server.log.YYYY-MM-DD.
# LOG_LEVEL=INFO
# LOG_DIR=./logs
# When a new file starts: midnight (default), H (hourly), D (daily from
# startup), W0-W6 (weekly, W0 = Monday), M or S. Unknown values: midnight.
# LOG_FILE_ROLL_OVER_TIME=midnight
# How many old files are kept (at midnight: days).
# LOG_FILE_BACKUPS=5
#
# Audit trail of who-holds-what changes (entries, shares, placements, GC),
# IDs only. Default: <LOG_DIR>/audit.log, rotated like server.log.
# LOG_AUDIT_FILE=./logs/audit.log
