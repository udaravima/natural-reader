# ─── Server / Network ────────────────────────────────────────────────────────
# Bind address for the FastAPI/Kokoro server. Defaults to 127.0.0.1 (localhost
# only) so the API is never exposed off-box by accident. For a containerized or
# reverse-proxied deployment, set HOST=0.0.0.0 explicitly — the proxy should be
# the only internet-facing surface.
# HOST=127.0.0.1
# PORT=8000
# WORKERS=1

# Comma-separated CORS allowlist for the browser frontend. Unset = permissive
# ("*", credentials disabled) so the read-aloud extension keeps working. Pin it
# to your real origin(s) for a deployment; doing so also enables credentialed
# (cookie) requests.
# FRONTEND_ORIGIN=https://reader.example.com

# ─── Authentication (OIDC / multi-user) ──────────────────────────────────────
# The app is an OIDC Relying Party. Point these at your IdP (e.g. Keycloak).
# With AUTH_ENABLED=true (default) and OIDC unset, /v1/auth/login returns 503 but
# TTS still serves; set the four OIDC_* vars to enable login.
# OIDC_ISSUER=https://keycloak.example.com/realms/natural-reader
# OIDC_CLIENT_ID=natural-reader
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URL=https://reader.example.com/v1/auth/callback
#
# Local dev against the docker-compose Keycloak + checked-in realm
# (deploy/keycloak/realm-export.json). The issuer URL must be identical for the
# browser AND the backend (both localhost:18080) or token validation fails.
# OIDC_ISSUER=http://localhost:18080/realms/natural-reader
# OIDC_CLIENT_ID=natural-reader
# OIDC_CLIENT_SECRET=natural-reader-dev-secret
# OIDC_REDIRECT_URL=http://localhost:5173/v1/auth/callback   # Vite dev; use your nginx origin for prod-like
#
# Production behind nginx + TLS (see docs/DEPLOYMENT.md). All five of ISSUER,
# REDIRECT_URL, COOKIE_SECURE, the two KC_* vars below, AND the live realm's
# redirect URIs must agree on https + hostname, or login fails a different way at
# each mismatch:
# OIDC_ISSUER=https://auth.oraian.net/realms/natural-reader
# OIDC_CLIENT_ID=natural-reader
# OIDC_CLIENT_SECRET=<realm client secret>
# OIDC_REDIRECT_URL=https://chat.oraian.net/v1/auth/callback
#
# Keycloak behind a TLS-terminating reverse proxy (consumed by docker-compose.yml,
# empty by default so plain localhost dev is unchanged). Without these, Keycloak
# emits http:// asset/iframe URLs the browser blocks as mixed content and its OIDC
# `issuer` won't match OIDC_ISSUER. Set both for a proxied deploy:
# KC_PROXY_HEADERS=xforwarded
# KC_HOSTNAME=https://auth.oraian.net
#
# Signs the transient OIDC-flow cookie. MANDATORY for any non-loopback (exposed
# or containerized) bind: the server REFUSES TO START without a value of >= 32
# chars, so it can never fall back to a forgeable signing key. On a loopback bind
# it's optional — an ephemeral per-process secret is used (won't survive a
# restart or work across WORKERS>1). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# App session lifetime (hours) and cookie flags.
# SESSION_TTL_HOURS=168
# COOKIE_SECURE=true            # set false only for local http (no TLS) testing
# Leave COOKIE_DOMAIN unset for localhost. Only set it (to your registrable
# domain) once served from a real hostname — a value that doesn't match the
# origin silently drops the session cookie and login appears to do nothing.
# COOKIE_DOMAIN=
#
# Pre-designate the admin: the seed admin row's email is set to this, so this
# person's first OIDC login claims it and inherits any pre-existing data. Removes
# the "first login wins" race on a fresh multi-user install.
#   TRAP: setting this routes the founder through the *email-claim* path
#   (resolve_or_provision_user branch 2), which — unlike the first-login race
#   (branch 3) — does NOT force-grant {admin,reader,chat}. It just mirrors
#   whatever realm roles the token carries. So if this founder's Keycloak user
#   has no realm roles assigned, their capabilities are wiped to empty on the
#   FIRST login and they land on "your account is active but has no access yet".
#   Guard against it EITHER by assigning the realm roles to that user in Keycloak
#   (the checked-in realm-export gives admin-user reader/chat/admin directly) OR
#   by setting KC_ADMIN_* below so the app self-heals the roles on bootstrap.
#   See docs/DEPLOYMENT.md Trap 4 and docs/IDENTITY_AND_ROLES.md.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
#
# Local-dev escape hatch: skip OIDC entirely and treat every request as the
# bootstrap admin. REFUSES TO START unless HOST is loopback. Never set on an
# exposed server.
# AUTH_ENABLED=true
#
# Keycloak Admin REST service account (enables full user provisioning + role
# management from the app). The client_secret MUST match the natural-reader-admin
# client's secret in the LIVE realm (dev value in realm-export.json is
# natural-reader-admin-dev-secret; rotate it for a real deployment).
#   Unset = app-only degraded mode, with two consequences worth knowing:
#     1. The founder-bootstrap self-heal is dead: when the seed admin is first
#        claimed, the app tries to assign reader/chat/admin back into Keycloak so
#        the next login's sync doesn't demote the founder — that call is skipped
#        when this is unset (see BOOTSTRAP_ADMIN_EMAIL trap above).
#     2. The admin console's capability editor becomes a DB-only sticky note: an
#        edit on an already-linked user can't reach Keycloak, so login sync
#        reverts it on that user's next login.
# KC_ADMIN_CLIENT_ID=natural-reader-admin
# KC_ADMIN_CLIENT_SECRET=change-me

# ─── TTS request limits (SEC-4) ──────────────────────────────────────────────
# Caps that keep a single request from monopolizing Kokoro (inference is
# serialized under one global lock).
# TTS_MAX_TEXT_CHARS=20000
# TTS_MAX_SENTENCES=2000
# TTS_MAX_SENTENCE_CHARS=5000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Defaults match docker-compose.yml.
# DATABASE_URL=postgresql://natural_reader:natural_reader@localhost:5433/natural_reader
# Password for the docker-compose Postgres (compose reads POSTGRES_PASSWORD).
# Override for anything past a local dev box, and mirror it in DATABASE_URL.
# POSTGRES_PASSWORD=natural_reader

# ─── Ollama ──────────────────────────────────────────────────────────────────
# Base URL of the Ollama server.
# OLLAMA_URL=http://localhost:11434

# ─── Inference gateway (model router) ────────────────────────────────────────
# The SPA's chat runs through the authenticated /v1/inference/* gateway (the
# "Inference source: Server" setting). These knobs shape what that gateway
# allows and spends.
#
# Comma-separated model allowlist served through /v1/inference/*. Unset = all
# installed models (local-dev convenience). Set it on any shared deployment —
# it's also what the SPA's model dropdown offers.
# INFERENCE_MODELS=gemma3,qwen2.5
#
# Default per-user daily token budget (prompt + eval, from Ollama's real
# counts). Unset or 0 = unlimited. Per-user override lives on the users table
# (admin PATCH /v1/admin/users/{id}) — NULL = this default, 0 = unlimited.
# Budgets roll at UTC midnight.
# INFERENCE_DAILY_TOKEN_BUDGET=500000
#
# Upstream read timeout (seconds) for streamed generations — slow models can
# think for minutes, so this is generous by default.
# INFERENCE_TIMEOUT_S=300
#
# Model for server-side summarize tasks (web_search page summaries, and the
# document-library description generation to come). Replaces the older
# WEB_SEARCH_SUMMARY_MODEL name, which still works as a fallback.
# SUMMARIZE_MODEL=llama3.2:3b

# ─── Embedding Model ────────────────────────────────────────────────────────
# Model name as known to Ollama (must be pulled first: `ollama pull <model>`).
# EMBEDDING_MODEL=nomic-embed-text

# Dimensionality of the embedding vector. Must match the model's output dim.
# Changing this requires re-creating the doc_chunks.embedding column and
# re-indexing all documents.
#   nomic-embed-text  → 768
#   mxbai-embed-large → 1024
#   all-minilm         → 384
# EMBEDDING_DIM=768

# Maximum characters sent to the embedding model per chunk. Text exceeding
# this limit is truncated. Tune this to match the model's context window:
#   nomic-embed-text  (2048 tokens default in Ollama) → ~2000 chars
#   mxbai-embed-large (512 tokens)                    → ~1500 chars
# If you've increased num_ctx in a custom Modelfile, raise this accordingly.
# EMBEDDING_MAX_CHARS=2000

# Per-request timeout in seconds for Ollama embedding calls.
# EMBEDDING_TIMEOUT_S=30

# Maximum number of concurrent embedding requests to Ollama.
# Higher values saturate the pipeline faster but use more memory.
# EMBEDDING_MAX_CONCURRENCY=4

# ─── Web Search (SearXNG-backed web_search tool) ─────────────────────────────
# Base URL of the self-hosted SearXNG instance (see docker-compose.yml). JSON
# output must be enabled in searxng/settings.yml or every search 403s.
# (docker-compose binds it to 127.0.0.1:18043 by default — localhost only.)
# SEARXNG_URL=http://localhost:18043
#
# Small model used to summarize each fetched page (pull it: `ollama pull llama3.2:3b`).
# The capable chat model still does the final synthesis; this only condenses pages.
# WEB_SEARCH_SUMMARY_MODEL=llama3.2:3b
#
# Results fetched+summarized per query (1-10). Each is a full page fetch plus a
# model call, so this dominates latency.
# WEB_SEARCH_RESULT_COUNT=5
#
# Max parallel fetch+summarize jobs (matches the embedding pipeline default).
# WEB_SEARCH_MAX_CONCURRENCY=4
#
# Per-page fetch timeout (seconds).
# WEB_SEARCH_FETCH_TIMEOUT_S=8
#
# Per-summary Ollama timeout (seconds).
# WEB_SEARCH_SUMMARY_TIMEOUT_S=30
#
# Extracted page text truncated to this many chars before summarizing.
# WEB_SEARCH_MAX_PAGE_CHARS=6000

# ─── Document storage & uploads (A1) ──────────────────────────────────────────
# Where uploaded document bytes live (<dir>/<doc_id>.<ext>). Falls back to
# PDF_STORAGE_DIR (the pre-A1 name), then ./data/pdfs. Existing files stay put.
# DOC_STORAGE_DIR=./data/pdfs
# PDF_STORAGE_DIR=./data/pdfs
# Upload size caps in MB. Over the cap → HTTP 413.
# PDF_UPLOAD_MAX_MB=50
# TEXT_UPLOAD_MAX_MB=10

# ─── Logging ─────────────────────────────────────────────────────────────────
# The backend logs to the console AND a size-rotating file (logs/ is gitignored).
# LOG_LEVEL=INFO
# LOG_DIR=./logs
# LOG_FILE_MAX_MB=10
# LOG_FILE_BACKUPS=5
#
# Audit trail of who-holds-what changes (entries, shares, placements, GC),
# IDs only. Default: <LOG_DIR>/audit.log, rotated like server.log.
# LOG_AUDIT_FILE=./logs/audit.log
