[
  {"name": "takes words the engine is sure of", "fn": "heard_speech",
   "input": {"text": "Stop.", "no_speech": 0.05, "avg_logprob": -0.5, "limits": {"max_no_speech": 0.4, "min_logprob": -1.0}}, "expect": true},
  {"name": "refuses what the engine thinks is not speech", "fn": "heard_speech",
   "input": {"text": "Thank you.", "no_speech": 0.5, "avg_logprob": -0.3, "limits": {"max_no_speech": 0.4, "min_logprob": -1.0}}, "expect": false},
  {"name": "no_speech exactly at the limit is refused", "fn": "heard_speech",
   "input": {"text": "Thank you.", "no_speech": 0.4, "avg_logprob": -0.3, "limits": {"max_no_speech": 0.4, "min_logprob": -1.0}}, "expect": false},
  {"name": "refuses words the engine is unsure of", "fn": "heard_speech",
   "input": {"text": "Woof, woof!", "no_speech": 0.1, "avg_logprob": -1.3, "limits": {"max_no_speech": 0.4, "min_logprob": -1.0}}, "expect": false},
  {"name": "avg_logprob exactly at the limit is taken", "fn": "heard_speech",
   "input": {"text": "Hello", "no_speech": 0.1, "avg_logprob": -1.0, "limits": {"max_no_speech": 0.4, "min_logprob": -1.0}}, "expect": true},
  {"name": "refuses a clip with no letters or digits", "fn": "heard_speech",
   "input": {"text": " ... ", "no_speech": 0.1, "avg_logprob": -0.2, "limits": {"max_no_speech": 0.4, "min_logprob": -1.0}}, "expect": false},
  {"name": "refuses empty text", "fn": "heard_speech",
   "input": {"text": "", "no_speech": null, "avg_logprob": null, "limits": {"max_no_speech": 0.4, "min_logprob": -1.0}}, "expect": false},
  {"name": "takes any words from an engine with no scores", "fn": "heard_speech",
   "input": {"text": "Hello", "no_speech": null, "avg_logprob": null, "limits": {"max_no_speech": 0.4, "min_logprob": -1.0}}, "expect": true},
  {"name": "digits alone are speech", "fn": "heard_speech",
   "input": {"text": "42", "no_speech": null, "avg_logprob": null, "limits": {"max_no_speech": 0.4, "min_logprob": -1.0}}, "expect": true},
  {"name": "knows its own words coming back", "fn": "is_echo",
   "input": {"text": "the capital of France", "said": ["The capital of France is Paris."]}, "expect": true},
  {"name": "is not fooled by a few shared words", "fn": "is_echo",
   "input": {"text": "what about the capital of Germany then", "said": ["The capital of France is Paris."]}, "expect": false},
  {"name": "never drops a short clip", "fn": "is_echo",
   "input": {"text": "France", "said": ["The capital of France is Paris."]}, "expect": false},
  {"name": "two words are still too short", "fn": "is_echo",
   "input": {"text": "Paris, stop", "said": ["The capital of France is Paris."]}, "expect": false},
  {"name": "with nothing said there is nothing to echo", "fn": "is_echo",
   "input": {"text": "the capital of France", "said": []}, "expect": false},
  {"name": "words from several sentences count together", "fn": "is_echo",
   "input": {"text": "capital of France is Paris", "said": ["The capital of France.", "It is Paris."]}, "expect": true},
  {"name": "an apostrophe stays inside a word", "fn": "is_echo",
   "input": {"text": "that's what it's about", "said": ["That's what it's about, really."]}, "expect": true},
  {"name": "a file name spoken with dot comes back as echo", "fn": "is_echo",
   "input": {"text": "architecture dot md", "said": ["Architecture dot md"]}, "expect": true}
]
